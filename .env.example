# Инлайнится в бандл на этапе сборки (NEXT_PUBLIC_*).
# В CI прод-значение задаётся build-arg'ом: https://api.rick-morty.welt-on.com
NEXT_PUBLIC_API_URL=http://localhost:4009

# Адрес API для серверных запросов (опционально; по умолчанию = NEXT_PUBLIC_API_URL).
# В кластере: http://rick-morty-backend.rick-morty.svc.cluster.local
# API_URL=
